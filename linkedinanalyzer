       const WEBHOOK_URL = "https://romhyalexandracubas.app.n8n.cloud/webhook/linkedin-analyzer-v2";

async function analyzePost(postText) {
    const res = await fetch(WEBHOOK_URL, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ post: postText })
    });

    const raw = await res.text();

    if (!res.ok) {
        throw new Error(`HTTP ${res.status}: ${raw.slice(0, 200)}`);
    }

    try {
        return JSON.parse(raw);
    } catch {
        throw new Error(`Invalid JSON returned from server: ${raw.slice(0, 200)}`);
    }
}

