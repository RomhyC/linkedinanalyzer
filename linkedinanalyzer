                    <p>Consider these improvements:</p>
                    <ul>
                        ${analysis.cta.suggestions.map(item => `<li>${item}</li>`).join('')}
                    </ul>
                    <p><strong>Example:</strong> "${analysis.cta.example}"</p>
                </div>
            </div>

            <div class="divider"></div>

            <div class="section">
                <div class="section-header">
                    <h2>
                        <span class="section-icon">🚀</span>
                        Virality Prediction
                    </h2>
                    <span class="collapse-arrow">▼</span>
                </div>
                <div class="section-body">
                    <p><strong>Estimated engagement potential:</strong> ${analysis.virality.potential}</p>
                    <p>To increase viral potential:</p>
                    <ul>
                        ${analysis.virality.suggestions.map(item => `<li>${item}</li>`).join('')}
                    </ul>
                </div>
            </div>

            <div class="divider"></div>

            <div class="section">
                <div class="section-header">
                    <h2>
                        <span class="section-icon">✍️</span>
                        Suggested Rewrite
                    </h2>
                    <span class="collapse-arrow">▼</span>
                </div>
                <div class="section-body">
                    <div class="rewrite-box" id="rewriteContent">
                        ${analysis.rewrite.replace(/\n/g, '<br>')}
                    </div>
                    <div style="margin-top: 12px; display: flex; gap: 8px;">
                        <button class="copy-btn" id="copyRewriteBtn">
                            📋 Copy rewrite
                        </button>
                    </div>
                </div>
            </div>
            `;
            
            results.innerHTML = resultsHTML;
            
            generateSuggestionCards(analysis);
            
            document.querySelectorAll('.section-header').forEach(header => {
                header.addEventListener('click', function() {
                    this.parentElement.classList.toggle('collapsed');
                });
            });
            
            const copyRewriteBtn = document.getElementById('copyRewriteBtn');
            if (copyRewriteBtn) {
                copyRewriteBtn.addEventListener('click', function(e) {
                    e.stopPropagation();
                    const rewriteContent = document.getElementById('rewriteContent');
                    const textToCopy = rewriteContent.textContent.trim();
                    
                    navigator.clipboard.writeText(textToCopy).then(() => {
                        const originalText = this.innerHTML;
                        this.innerHTML = '✓ Copied!';
                        this.classList.add('copied');
                        
                        setTimeout(() => {
                            this.innerHTML = originalText;
                            this.classList.remove('copied');
                        }, 2000);
                    }).catch(err => {
                        alert('Failed to copy to clipboard');
                    });
                });
            }
            
            document.querySelectorAll('.score-item').forEach(item => {
                item.addEventListener('click', () => {
                    const score = item.dataset.score;
                    const label = item.querySelector('.score-label').textContent;
                    alert(`${label} Score: ${score}/10\n\nClick to see detailed breakdown of this dimension.`);
                });
            });
        }

        function generateSuggestionCards(analysis) {
            const suggestions = [];
            
            if (analysis.scores.hook < 7) {
                suggestions.push({
                    icon: '🎣',
                    title: 'Strengthen Your Hook',
                    text: analysis.hook_analysis.recommendation,
                    action: 'strengthen_hook'
                });
            }
            
            if (analysis.scores.reward < 7) {
                suggestions.push({
                    icon: '🎁',
                    title: 'Add Stronger Takeaway',
                    text: 'End with a clear, memorable insight that readers can apply immediately.',
                    action: 'add_takeaway'
                });
            }
            
            if (analysis.cta.strength.toLowerCase().includes('weak') || analysis.cta.strength.toLowerCase().includes('moderate')) {
                suggestions.push({
                    icon: '📢',
                    title: 'Improve Call-to-Action',
                    text: analysis.cta.example,
                    action: 'improve_cta'
                });
            }
            
            if (analysis.virality.potential === 'Low' || analysis.virality.potential === 'Medium') {
                suggestions.push({
                    icon: '🚀',
                    title: 'Boost Engagement Potential',
                    text: analysis.virality.suggestions[0] || 'Add emotional resonance or a quotable line.',
                    action: 'boost_virality'
                });
            }
            
            const container = document.getElementById('suggestionCards');
            if (!container || suggestions.length === 0) {
                if (container) {
                    container.innerHTML = '<p style="color: #0284c7; font-weight: 600;">◆ Excellent! Your post is already optimized. No critical improvements needed.</p>';
                }
                return;
            }
            
            container.innerHTML = suggestions.map((suggestion, index) => `
                <div class="suggestion-card" data-index="${index}">
                    <div class="suggestion-header">
                        <div class="suggestion-title">
                            <span class="suggestion-icon">${suggestion.icon}</span>
                            ${suggestion.title}
                        </div>
                        <span class="suggestion-status">Suggested</span>
                    </div>
                    <div class="suggestion-text">${suggestion.text}</div>
                    <div class="suggestion-actions">
                        <button class="apply-btn" onclick="applySuggestion(${index}, '${suggestion.action}')">
                            ✓ Apply
                        </button>
                        <button class="dismiss-btn" onclick="dismissSuggestion(${index})">
                            Dismiss
                        </button>
                    </div>
                </div>
            `).join('');
        }
        
        window.applySuggestion = function(index, action) {
            const card = document.querySelector(`.suggestion-card[data-index="${index}"]`);
            if (!card) return;
            
            card.classList.add('applied');
            card.querySelector('.suggestion-status').textContent = 'Applied';
            card.querySelector('.suggestion-actions').innerHTML = '<span style="color: #0284c7; font-size: 12px; font-weight: 600;">◆ Suggestion applied to your post</span>';
            
            alert('Noted. This improvement has been marked for your next revision.');
        }
        
        window.dismissSuggestion = function(index) {
            const card = document.querySelector(`.suggestion-card[data-index="${index}"]`);
            if (!card) return;
            
            card.style.opacity = '0';
            card.style.transform = 'translateX(-20px)';
            setTimeout(() => {
                card.remove();
                
                const remaining = document.querySelectorAll('.suggestion-card').length;
                if (remaining === 0) {
                    document.getElementById('suggestionCards').innerHTML = '<p style="color: #00000099; font-style: italic;">All suggestions dismissed.</p>';
                }
            }, 300);
        }

        const viralPostInput = document.getElementById('viralPostInput');
        const viralCharCounter = document.getElementById('viralCharCounter');
        const exampleViralLink = document.getElementById('exampleViralLink');
        const decodeBtn = document.getElementById('decodeBtn');
        const clearViralBtn = document.getElementById('clearViralBtn');
        const decodeLoadingAnimation = document.getElementById('decodeLoadingAnimation');
        const decodeResults = document.getElementById('decodeResults');

        const viralExamplePost = `I got fired from my dream job.

Best thing that ever happened to me.

Here's why losing everything forced me to build something better:

2 years ago, I was the "rising star" at a tech company.
Great salary. Corner office. All the validation I thought I needed.

Then one day: "We're going in a different direction."

I spent 3 months applying to similar roles.
Got nowhere.

Then I stopped trying to recreate what I lost.
Started asking: what would I build if I wasn't trying to impress anyone?

6 months later:
→ Launched my own consultancy
→ Tripled my old salary
→ Work with clients I actually respect
→ Set my own hours

The job I thought was my dream was just someone else's vision of success.

Getting fired didn't end my career.
It started it.

What's one "failure" that turned into your biggest opportunity?`;

        viralPostInput.addEventListener('input', () => {
            const length = viralPostInput.value.length;
            viralCharCounter.textContent = `${length} character${length !== 1 ? 's' : ''}`;
            
            if (length > 0) {
                viralPostInput.classList.add('has-content');
            } else {
                viralPostInput.classList.remove('has-content');
            }
        });

        exampleViralLink.addEventListener('click', (e) => {
            e.preventDefault();
            viralPostInput.value = viralExamplePost;
            viralPostInput.dispatchEvent(new Event('input'));
            viralPostInput.focus();
        });

        clearViralBtn.addEventListener('click', () => {
            viralPostInput.value = '';
            viralPostInput.dispatchEvent(new Event('input'));
            decodeResults.classList.remove('visible');
        });

        decodeBtn.addEventListener('click', async () => {
            if (viralPostInput.value.trim()) {
                decodeLoadingAnimation.classList.add('active');
                decodeResults.classList.remove('visible');
                decodeBtn.disabled = true;
                
                try {
                    const analysis = await analyzePost(viralPostInput.value);
                    
                    updateDecodeResults(analysis);
                    
                    decodeLoadingAnimation.classList.remove('active');
                    decodeResults.classList.add('visible');
                    decodeResults.scrollIntoView({ behavior: 'smooth', block: 'start' });
                    
                } catch (error) {
                    console.error('Decode error:', error);
                    decodeLoadingAnimation.classList.remove('active');
                    
                    decodeResults.innerHTML = `
                        <div class="section">
                            <div class="section-header">
                                <h2 style="color: #dc3545;">
                                    <span class="section-icon" style="background: #dc3545;">⚠️</span>
                                    Analysis Error
                                </h2>
                            </div>
                            <div class="section-body">
                                <p><strong>Failed to decode post.</strong></p>
                                <p style="color: #00000099;">${error.message}</p>
                                <p style="margin-top: 16px;">Please try again or contact support if the issue persists.</p>
                            </div>
                        </div>
                    `;
                    decodeResults.classList.add('visible');
                } finally {
                    decodeBtn.disabled = false;
                }
            } else {
                alert('Please paste a LinkedIn post to decode.');
            }
        });

        function updateDecodeResults(analysis) {
            const resultsHTML = `
            <span class="example-badge">Success Decoded</span>
            
            <h2>
                <span class="section-icon">📊</span>
                Framework Scores
            </h2>
            <div class="scorecard">
                <div class="score-item high-score" data-score="${analysis.scores.hook}">
                    <div class="score-label">Hook</div>
                    <div class="score-value high-score">${analysis.scores.hook}<span class="score-total">/10</span></div>
                    <div class="score-bar"><div class="score-fill high-score" style="width: ${analysis.scores.hook * 10}%"></div></div>
                </div>
                <div class="score-item high-score" data-score="${analysis.scores.retain}">
                    <div class="score-label">Retain</div>
                    <div class="score-value high-score">${analysis.scores.retain}<span class="score-total">/10</span></div>
                    <div class="score-bar"><div class="score-fill high-score" style="width: ${analysis.scores.retain * 10}%"></div></div>
                </div>
                <div class="score-item high-score" data-score="${analysis.scores.reward}">
                    <div class="score-label">Reward</div>
                    <div class="score-value high-score">${analysis.scores.reward}<span class="score-total">/10</span></div>
                    <div class="score-bar"><div class="score-fill high-score" style="width: ${analysis.scores.reward * 10}%"></div></div>
                </div>
            </div>
<div class="divider"></div>

        <div class="section">
            <div class="section-header">
                <h2>
                    <span class="section-icon">🎯</span>
                    Why This Works
                </h2>
                <span class="collapse-arrow">▼</span>
            </div>
            <div class="section-body">
                <p>${analysis.why_it_works || analysis.core_narrative}</p>
            </div>
        </div>

        <div class="divider"></div>

        <div class="section">
            <div class="section-header">
                <h2>
                    <span class="section-icon">🎣</span>
                    Hook Breakdown
                </h2>
                <span class="collapse-arrow">▼</span>
            </div>
            <div class="section-body">
                <p><strong>Technique Used:</strong> ${analysis.hook_breakdown?.technique || analysis.hook_analysis.strength}</p>
                <p><strong>Psychology:</strong> ${analysis.hook_breakdown?.psychology || analysis.hook_analysis.weakness}</p>
                <p><strong>How to Replicate:</strong> ${analysis.hook_breakdown?.replicable_pattern || analysis.hook_analysis.recommendation}</p>
            </div>
        </div>
        `;
        
        decodeResults.innerHTML = resultsHTML;
        
        document.querySelectorAll('.section-header').forEach(header => {
            header.addEventListener('click', function() {
                this.parentElement.classList.toggle('collapsed');
            });
        });
    }
</script>
</body>
</html>
